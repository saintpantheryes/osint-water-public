# install.sh 会据此生成 .env(密码随机);手工部署时复制为 .env 并把 replace_* 换掉。
TEABLE_HOST=water.example.uk
PUBLIC_ORIGIN=https://water.example.uk

POSTGRES_PASSWORD=replace_this_password
REDIS_PASSWORD=replace_this_password
SECRET_KEY=replace_this_secret_key

POSTGRES_HOST=teable-db
POSTGRES_PORT=5432
POSTGRES_DB=teable
POSTGRES_USER=teable

REDIS_HOST=teable-cache
REDIS_PORT=6379
REDIS_DB=0

PRISMA_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
BACKEND_CACHE_PROVIDER=redis
BACKEND_CACHE_REDIS_URI=redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# 管理员建好后 install.sh 会把它改成 true:之后只能凭邀请链接加入
DISABLE_SIGNUP=false
